{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mindroot",
  "version": "0.2.1",
  "identifier": "app.mindroot.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mindroot",
        "width": 1360,
        "height": 860,
        "minWidth": 720,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false
      },
      {
        "label": "capture",
        "title": "Quick capture",
        "url": "index.html#/capture",
        "width": 560,
        "height": 96,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "center": true,
        "focus": true,
        "transparent": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' blob:; img-src 'self' data: blob: https: http:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost wss: ws://localhost:* ws://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkzNEVDQkE4NDBBMzFFNDUKUldSRkhxTkFxTXRPa3dWWTY5Zk9Zb0M5UUhTQ2ZpN0NhRlFvMzdwMU9zTjJpU3lIZHlwa3B6NkIK",
      "endpoints": [
        "https://github.com/falhad/mindroot/releases/latest/download/latest.json"
      ]
    }
  }
}
